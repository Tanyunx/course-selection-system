{
  "//": "VS Code 工作区配置。团队约定：Windows 上用 Git Bash 作为任务终端（与 Linux 服务器命令保持一致）。",

  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.associations": {
    "*.sql": "sql",
    ".env.example": "properties",
    "*.env": "properties"
  },
  "files.exclude": {
    "**/target": true,
    "**/node_modules": true,
    "**/.uicheck/node_modules": true,
    "**/.uicheck/esm": true,
    "**/.uicheck/inline-bundle.js": true
  },
  "search.exclude": {
    "backend/target": true,
    "legacy": true,
    ".uicheck/node_modules": true,
    "选课系统-单文件版.html": true,
    "docs/index.html": true
  },

  "//java": "Java 工具链：JDK 21。改 JDK 路径时优先用环境变量 JAVA_HOME，不要写进仓库。",
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.compile.nullAnalysis.mode": "automatic",
  "java.format.settings.profile": "GoogleStyle",
  "java.jdt.ls.vmargs": "-Xmx1G",
  "java.import.maven.enabled": true,
  "java.maven.downloadSources": false,
  "maven.executable.preferMavenWrapper": false,

  "//spring": "Spring Boot 面板：会自动发现 CourseSelectionApplication 并列出所有 @RestController 接口。",
  "spring-boot.ls.problem.application-properties.unknown-property": "IGNORE",

  "//terminal": "统一用 Git Bash，保证 Windows 本地与 Ubuntu 服务器上的命令一致。",
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "terminal.integrated.cwd": "${workspaceFolder}",

  "//live-server": "前端是原生 ES Module，改完直接刷新即可；用 http.server 或 tools/serve-frontend.js 托管。",
  "liveServer.settings.root": "/frontend",
  "liveServer.settings.port": 5500,

  "emmet.includeLanguages": {
    "javascript": "javascriptreact"
  }
}
