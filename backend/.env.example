# ---------------------------------------------------------------
# 后端环境变量示例（复制为 .env 后填写；.env 已被 .gitignore 排除）
#
# Spring Boot 读取环境变量的方式：application.yml 里用 ${VAR:默认值} 占位，
# 因此这里导出的变量会覆盖 yml 中的默认值。
# 本地开发用 tools/run-backend.sh 加载本文件并启动服务。
# ---------------------------------------------------------------

# ---------- 服务监听 ----------
# 变量名刻意避开 PORT/HOST：很多云平台与容器运行时会预设这两个变量，
# 会静默改掉监听端口，排查起来很费时间。
# 只监听回环地址 = 只有本机能访问；生产环境由 Nginx 反向代理，保持 127.0.0.1 更安全
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=3000

# ---------- PostgreSQL 连接 ----------
DB_HOST=127.0.0.1
# 本地开发用免安装实例的端口；服务器上装的是系统 PostgreSQL，默认 5432
DB_PORT=55432
DB_NAME=course_selection
DB_USER=course_app
# 口令只放在这个文件里，绝不写进源码、脚本或版本库
DB_PASSWORD=
# 连接池大小；单机 2 核 2G 的云服务器建议 10~20
DB_POOL=10

# ---------- 会话与安全 ----------
# 令牌签名密钥：生产环境务必换成随机长串
#   openssl rand -hex 32
AUTH_SECRET=
# 会话空闲超时（分钟）
AUTH_IDLE_MINUTES=30
# 登录连续失败多少次后要求输入验证码
AUTH_CAPTCHA_AFTER=5

# ---------- 防刷限速（时间窗口内同一账号的写操作次数） ----------
RL_WINDOW_SECONDS=60
RL_SOFT_LIMIT=10
RL_HARD_LIMIT=20

# ---------- 业务参数 ----------
IDEMPOTENCY_TTL_MINUTES=5
WAITLIST_CONFIRM_HOURS=24
DROP_DEADLINE_DAYS=7

# ---------- 跨域（前后端分离） ----------
# * 放行任意来源，仅适合开发与公开演示；
# 生产环境收敛为前端实际地址，例如：https://course.example.com
CORS_ORIGINS=*

# ---------- 数据初始化 ----------
# true = 启动时重建 18 张表并导入演示数据（会清空原有数据！）
# 仅在首次部署或重置演示环境时打开，跑完立刻改回 false
DB_INIT=false
