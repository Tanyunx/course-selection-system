# 环境变量模板
#
# 用法：复制本文件为 .env（同一目录），按实际情况修改。
#       .env 已被 .gitignore 忽略，不会被提交到版本库，可安全存放真实口令。
#
# 优先级：真实环境变量 > .env 文件 > config/config.js 中的默认值
# 因此用 pm2 / systemd / Docker 注入环境变量时，本文件不会造成干扰。

# ---- 数据库连接（必填：DB_PASSWORD）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=course_selection
DB_POOL=10

# ---- 应用服务 ----
# 本机开发保持 127.0.0.1；部署到服务器必须改成 0.0.0.0，否则外网无法访问
PORT=3000
HOST=127.0.0.1

# ---- 会话密钥与超时 ----
# 生产环境务必改成随机字符串
AUTH_SECRET=please-change-me
AUTH_IDLE_MINUTES=30
# 登录连续失败多少次后要求输入验证码
AUTH_CAPTCHA_AFTER=5

# ---- 防刷限速 ----
# 60 秒内超过 softLimit 次选课写请求触发限速，超过 hardLimit 次要求验证码
RL_WINDOW_SECONDS=60
RL_SOFT_LIMIT=10
RL_HARD_LIMIT=20

# ---- 业务窗口 ----
# 幂等请求去重缓存时长（分钟）
IDEMPOTENCY_TTL_MINUTES=5
# 候补递补确认期（小时），超时未确认名额顺延给下一位
WAITLIST_CONFIRM_HOURS=24
# 退课截止：补退选批次结束后的第 N 天 23:59
DROP_DEADLINE_DAYS=7
